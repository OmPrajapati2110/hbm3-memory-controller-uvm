# Generic gate-level synthesis (technology independent) for area/complexity tracking.
read_verilog -sv rtl/hbm3_mc_pkg.sv rtl/mc_fifo.sv rtl/mc_rr_arb.sv rtl/mc_bank.sv rtl/mc_rank_timer.sv rtl/mc_refresh.sv rtl/hbm3_mc.sv
hierarchy -check -top hbm3_mc
synth -top hbm3_mc
flatten
opt_clean
tee -o syn/stat.txt stat
check -assert
